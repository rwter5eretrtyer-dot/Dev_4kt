# Replace all IPs and SSH login as appropriate for your lab.
# If you use a passphrase-protected key, load it with ssh-agent.
[control_plane]
master ansible_host=192.168.0.10

[workers]
worker1 ansible_host=192.168.0.11
worker2 ansible_host=192.168.0.12

[k8s:children]
control_plane
workers

[k8s:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_ed25519
